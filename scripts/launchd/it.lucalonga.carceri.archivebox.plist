<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Terza copia delle fonti con ArchiveBox, ogni lunedì alle 09:00 (dopo la raccolta delle schede).
     Gira solo dal disco interno: ~/Library/Application Support/carceri-italia/archivebox_servizio.sh
     (cloni dedicati, mai il repository di lavoro). Installazione: scripts/launchd/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>it.lucalonga.carceri.archivebox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/luca/Library/Application Support/carceri-italia/archivebox_servizio.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/luca/Library/Logs/carceri-archivebox.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/luca/Library/Logs/carceri-archivebox.log</string>
</dict>
</plist>
